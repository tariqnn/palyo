# Omit DATABASE_URL to use the persistent embedded PostgreSQL development database.
DATABASE_URL=
PLAYUP_DB_DIR=.playup-db
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_MINIMUM_AGE=16
PAYMENT_PROVIDER=mock
STREAM_PROVIDER=mock
# Set to 1 only on a Vercel Preview deployment protected by Vercel Authentication.
PLAYUP_PRIVATE_DEMO=
# Set to 1 only on the public Vercel Production demo with its own database.
PLAYUP_PUBLIC_DEMO=
# Unique, private admin password for the public Production demo (minimum 20 characters).
PLAYUP_ADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=

# Email: either Resend (RESEND_API_KEY + EMAIL_FROM) or SMTP below
RESEND_API_KEY=
EMAIL_FROM=PlayUp <no-reply@yourdomain.com>
